# /etc/systemd/system/jindianyun-chat.service
# 安装前把 your-user 和 /home/your-user 换成运行服务的账号和家目录。
[Unit]
Description=JindianYun web AI chat backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=your-user
Group=your-user
WorkingDirectory=/home/your-user/jindianyun-chat
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/your-user
# 密钥从 ~/.sf_key（或 SILICONFLOW_KEY_FILE）读取。不要把密钥写进这个文件。
# 可选：Environment=CHAT_RATE_PER_MIN=10
# 可选：Environment=CHAT_RATE_PER_DAY=100
# 可选：Environment=CHAT_GLOBAL_DAILY_CAP=1000
# uvicorn 0.32 默认开启代理头（forwarded_allow_ips 默认 127.0.0.1）。
# 不写 --proxy-headers 也会把 request.client 改成转发地址，端口记成 0，
# 应用就看不到本机对端。必须显式加上 --no-proxy-headers。
ExecStart=/home/your-user/jindianyun-chat/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8765 --no-proxy-headers
Restart=on-failure
RestartSec=5
MemoryMax=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jindianyun-chat

[Install]
WantedBy=multi-user.target
