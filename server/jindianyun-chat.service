# /etc/systemd/system/jindianyun-chat.service
[Unit]
Description=JindianYun web AI chat backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/jindianyun-chat
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/azureuser
# 密钥从 ~/.sf_key（或 SILICONFLOW_KEY_FILE）读取。不要把密钥写进这个文件。
ExecStart=/home/azureuser/jindianyun-chat/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8765 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
MemoryMax=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jindianyun-chat

[Install]
WantedBy=multi-user.target
