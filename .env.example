# 津电云 · 常青藤智能充电本地代理配置示例
# 复制为 .env 后填入个人参数（.env 已被 .gitignore 忽略，切勿提交到仓库）

# 微信小程序抓包获取的个人微信 OpenID（留空则代理默认运行在本地联调模拟模式）
OPEN_ID=

# 登录小程序使用的手机号
PHONENUMBER=

# 北洋园校区查询基准坐标（默认北洋园校区中心）
LONGITUDE=117.3085
LATITUDE=38.9965

# 本地代理监听端口与允许跨域来源
PORT=8787
ALLOW_ORIGIN=*

# 上游缓存时长（毫秒，建议不低于 60000 以防触发每分钟 15 次限流）
CACHE_TTL_MS=60000
